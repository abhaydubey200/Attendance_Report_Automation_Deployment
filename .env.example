# Copy to .env on the machine that runs the app. NEVER commit .env.

# ---- Email password (the only secret the tool needs). Username/server are set in the app's Settings.
# SMTP_PASSWORD=

# ---- Link to this app shown in emails (intranet address once hosted there)
# APP_PUBLIC_URL=http://attendance.apis.local

# ---- Environment: development | production
APP_ENV=development
# APP_STORAGE_DIR=D:\APIS_Attendance\storage   # uploads, reports, email outbox (default: ./storage)
# APP_LOG_DIR=D:\APIS_Attendance\logs

# ---- Access: none = no login page (this PC only) | local = sign-in. Production requires local.
# AUTH_MODE=none
# APP_SECRET_KEY=   # >= 32 random chars, required in production:  python -c "import secrets; print(secrets.token_urlsafe(48))"
# API_HOST=127.0.0.1
# API_PORT=8000

# ---- Database: SQLite by default (fine for one PC). For a shared server use SQL Server:
# DB_PROFILE=mssql
# DB_HOST=sqlserver.example.local
# DB_NAME=APIS_ATTENDANCE
# DB_TRUSTED_CONNECTION=yes        # or DB_USER= / DB_PASSWORD=
