# Copy to .env for local development. NEVER commit .env.
# Real environment variables take precedence over values in .env.

# ---- Environment: development | testing | production
APP_ENV=development
# APP_STORAGE_DIR=D:\APIS_MIS\storage     # default: ./storage
# APP_LOG_DIR=D:\APIS_MIS\logs            # default: ./logs
# APP_LOG_LEVEL=INFO

# ---- Database profile (config/database.yaml): dev_sqlite | mssql
DB_PROFILE=dev_sqlite
# DB_SQLITE_PATH=storage/dev/apis_mis_dev.db

# ---- SQL Server (when DB_PROFILE=mssql)
# DB_HOST=sqlserver.example.local
# DB_PORT=1433
# DB_NAME=APIS_ATTENDANCE_MIS
# DB_DRIVER=ODBC Driver 18 for SQL Server
# Either Windows integrated auth:
# DB_TRUSTED_CONNECTION=yes
# ...or SQL auth (least-privilege application login):
# DB_USER=
# DB_PASSWORD=
# DB_TRUST_SERVER_CERT=no

# ---- Optional AI (disabled in config/ai_config.yaml)
# AI_ENDPOINT=http://localhost:11434

# ---- API / sessions
# Session signing key, >= 32 random characters. REQUIRED in production.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
# APP_SECRET_KEY=
# API_HOST=127.0.0.1
# API_PORT=8000
