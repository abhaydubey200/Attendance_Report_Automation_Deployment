# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.coverage
htmlcov/

# Secrets -- never commit
.env
.env.*
!.env.example
*.pem
*.pfx
*.key

# HR data, reports, databases and logs -- never commit (PRD section 6)
storage/**
!storage/**/
!storage/**/.gitkeep
logs/**
!logs/.gitkeep
*.db
*.sqlite
*.sqlite3
*.xlsx
*.xls
*.csv
!tests/fixtures/**/*.csv
!tests/fixtures/**/*.xlsx

# Tooling
.vscode/
.idea/
.streamlit/secrets.toml
