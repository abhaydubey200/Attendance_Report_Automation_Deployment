# APIS Daily Attendance - PRODUCTION .env template (Windows Server, see docs/DEPLOYMENT.md).
# install.ps1 copies this to app\.env on the first run. Fill in the blanks, then run install.ps1 again.
# NEVER commit the filled-in .env. Readable only by the service account and administrators.

# ---- Environment
APP_ENV=production

# ---- Sign-in (production refuses to start without it)
AUTH_MODE=local
# >= 32 random characters:  .\.venv\Scripts\python.exe -c "import secrets; print(secrets.token_urlsafe(48))"
APP_SECRET_KEY=
API_HOST=127.0.0.1
API_PORT=8000
API_COOKIE_SECURE=true

# ---- Database: SQLite on this server (WAL, daily backup job)
DB_PROFILE=sqlite_prod
DB_SQLITE_PATH=D:\APIS_Attendance_Automation\data\database\attendance.db

# ---- Folders (data never lives inside app\)
APP_STORAGE_DIR=D:\APIS_Attendance_Automation\data\files
APP_INBOX_DIR=D:\APIS_Attendance_Automation\data\inbox
APP_LOG_DIR=D:\APIS_Attendance_Automation\data\logs

# ---- Link to this app shown in emails
APP_PUBLIC_URL=https://attendance.apis.local

# ---- Gmail API (the only way email is sent). Client from Google Cloud project apis-attendance-mis.
# GMAIL_REFRESH_TOKEN is written by:  .\.venv\Scripts\python.exe main.py gmail-auth --login-hint <sender mailbox>
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
# GMAIL_REFRESH_TOKEN=
