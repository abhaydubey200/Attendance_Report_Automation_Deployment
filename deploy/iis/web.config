<?xml version="1.0" encoding="utf-8"?>
<!--
  IIS site for the APIS Attendance app (e.g. http(s)://attendance.apis.local).
  Needs the IIS "URL Rewrite" and "Application Request Routing" (ARR) modules, with
  ARR proxy enabled (IIS Manager > server > Application Request Routing Cache > Server Proxy Settings > Enable proxy).
  The site's physical folder can be an empty folder that contains only this file:
  every request is forwarded to the app on 127.0.0.1:8000, which serves both the UI and the API.
-->
<configuration>
  <system.webServer>
    <rewrite>
      <rules>
        <rule name="APIS Attendance - forward to the app" stopProcessing="true">
          <match url="(.*)" />
          <action type="Rewrite" url="http://127.0.0.1:8000/{R:1}" />
        </rule>
      </rules>
    </rewrite>
    <!-- Uploads (attendance files, employee workbook) up to 25 MB, as the app allows. -->
    <security>
      <requestFiltering>
        <requestLimits maxAllowedContentLength="26214400" />
      </requestFiltering>
    </security>
    <httpProtocol>
      <customHeaders>
        <remove name="X-Powered-By" />
      </customHeaders>
    </httpProtocol>
  </system.webServer>
</configuration>
